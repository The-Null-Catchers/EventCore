# Generate independent secrets; do not reuse these fields or commit .env.
# Use URL-safe hex for POSTGRES_PASSWORD (it is embedded in a connection URL).
POSTGRES_PASSWORD=
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_WORKSPACE=demo
BOOTSTRAP_PASSWORD=
# base64 encoding of 32 random bytes, persist across restarts.
WEBHOOK_ENCRYPTION_KEY=
# For explicit local HTTP development only, set false. Production HTTPS: true.
COOKIE_SECURE=true

BROKER_MIN_FREE_BYTES=67108864
